# ── ManuFoundry Backend Environment ──────────────────────
# Copy to .env and adjust for your environment.

# App
APP_MODE=demo
DEBUG=true
LOG_LEVEL=INFO

# Auth — protected routes always require a token. DEMO_AUTH_OPTIONAL is kept
# only for compatibility; APP_MODE=production refuses to start when it is true.
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480
DEMO_AUTH_OPTIONAL=false

# CORS (comma-separated; use explicit origins in production)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Public app URL and SMTP for invites/password reset
APP_PUBLIC_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@manufoundry.local
SMTP_TLS=true

# PostgreSQL
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=manufoundry
POSTGRES_PASSWORD=manufoundry123
POSTGRES_DB=manufoundry

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=manufoundry123


# OpenAI (optional — for AI assistant)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
